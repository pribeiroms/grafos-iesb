graph G1 {
    // definição dos vértices do grafo
    1 [shape="circle"]
    2 [shape="circle"]
    3 [shape="circle"]
    4 [shape="circle"]
    5 [shape="circle"]
    6 [shape="circle"]
    7 [shape="circle"]
    8 [shape="circle"]
    // conexões entre os vértices
    1 -- 2
    1 -- 3
    1 -- 4
    2 -- 5
    2 -- 6
    // triângulo formado pelos vértices 3,4 e 7
    3 -- 4
    3 -- 7
    4 -- 7

    5 -- 6
    8 -- 5
    8 -- 6
    8 -- 7
}