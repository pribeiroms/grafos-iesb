digraph G2 {
    /*
    Grafo orientado com 6 vértices e 7 arcos.

    Diferentemente do grafo não orientado, as conexões possuem direção.
    Por isso, a -> b é diferente de b -> a.

    O fluxo parte de a e pode chegar até f.
    Este grafo não possui ciclos.
    */
    
    a [shape="circle"]
    b [shape="circle"]
    c [shape="circle"]
    d [shape="circle"]
    e [shape="circle"]
    f [shape="circle"]
    a -> b
    a -> c
    b -> d
    c -> d
    c -> e
    d -> f
    e -> f
}